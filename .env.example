# ===== SEE Notion — môi trường =====
# Copy file này thành .env rồi điền giá trị thật. KHÔNG commit file .env.

# --- Notion ---
NOTION_TOKEN=ntn_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NOTION_DATABASE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NOTION_VERSION=2022-06-28

# --- Discord ---
DISCORD_BOT_TOKEN=MTxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DISCORD_GUILD_ID=123456789012345678

# --- LLM (glm | ollama) ---
LLM_PROVIDER=glm
LLM_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx
LLM_MODEL=glm-4-flash
# Chỉ dùng khi LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434

# --- Email (smtp | resend) ---
EMAIL_BACKEND=smtp
EMAIL_FROM=SEE Notion Bot <yourbot@gmail.com>
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=yourbot@gmail.com
SMTP_PASS=abcdefghijklmnop        # App Password 16 ký tự, KHÔNG phải mật khẩu chính
RESEND_API_KEY=

# --- App ---
APP_TOKEN=doi-thanh-chuoi-ngau-nhien-32-ky-tu
DATABASE_URL=sqlite:///data/app.db
TZ_CONFIG=Asia/Ho_Chi_Minh
LOG_LEVEL=INFO
